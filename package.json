{
  "name": "gitfix",
  "displayName": "gitfix — Merge Conflict Inspector",
  "description": "Workspace-wide merge conflict inspector and companion to VS Code's built-in merge editor. Powered by gfix MCP.",
  "version": "0.2.0",
  "publisher": "ameyypawar",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ameyypawar/gitfix.git"
  },
  "homepage": "https://gfix.space",
  "bugs": {
    "url": "https://github.com/ameyypawar/gitfix/issues"
  },
  "engines": {
    "vscode": "^1.92.0",
    "node": ">=18"
  },
  "categories": ["SCM Providers", "Other"],
  "keywords": ["merge", "conflict", "git", "mergiraf", "mcp", "gitfix"],
  "preview": true,
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/.git/MERGE_HEAD"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitfix",
          "title": "gitfix",
          "icon": "media/gitfix-activity.svg"
        }
      ]
    },
    "views": {
      "gitfix": [
        {
          "id": "gitfix.conflicts",
          "name": "Merge Conflicts",
          "icon": "media/gitfix-activity.svg",
          "contextualTitle": "gitfix"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitfix.conflicts",
        "contents": "No active merge detected.\n\n[Refresh](command:gitfix.refresh)\n\ngitfix activates automatically when a merge is in progress. Start one with `git merge <branch>` in your terminal, then come back here.\n\n[Install gfix CLI](https://gfix.space) if you haven't already."
      }
    ],
    "commands": [
      {
        "command": "gitfix.refresh",
        "title": "Refresh Conflicts",
        "icon": "$(refresh)",
        "category": "gitfix"
      },
      {
        "command": "gitfix.openFile",
        "title": "Open in Editor",
        "icon": "$(go-to-file)",
        "category": "gitfix"
      },
      {
        "command": "gitfix.resolveOurs",
        "title": "Resolve: Take Ours",
        "icon": "$(arrow-left)",
        "category": "gitfix"
      },
      {
        "command": "gitfix.resolveTheirs",
        "title": "Resolve: Take Theirs",
        "icon": "$(arrow-right)",
        "category": "gitfix"
      },
      {
        "command": "gitfix.resolveMergiraf",
        "title": "Resolve: Run Mergiraf",
        "icon": "$(wand)",
        "category": "gitfix"
      },
      {
        "command": "gitfix.resolveTakeTarget",
        "title": "Resolve: Take Target Unchanged",
        "icon": "$(circle-slash)",
        "category": "gitfix"
      },
      {
        "command": "gitfix.resolveBatchMergiraf",
        "title": "Resolve Selected with Mergiraf",
        "icon": "$(wand)",
        "category": "gitfix"
      },
      {
        "command": "gitfix.applyMerge",
        "title": "Apply Merge",
        "icon": "$(check-all)",
        "category": "gitfix"
      },
      {
        "command": "gitfix.abortMerge",
        "title": "Abort Merge",
        "icon": "$(close)",
        "category": "gitfix"
      },
      {
        "command": "gitfix.showAuditRef",
        "title": "Show Audit Ref",
        "icon": "$(history)",
        "category": "gitfix"
      },
      {
        "command": "gitfix.configureAiProvider",
        "title": "Configure AI Provider",
        "category": "gitfix"
      },
      {
        "command": "gitfix.resolveAi",
        "title": "Resolve: With AI Suggestion",
        "icon": "$(sparkle)",
        "category": "gitfix"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitfix.refresh",
          "when": "view == gitfix.conflicts",
          "group": "navigation"
        },
        {
          "command": "gitfix.applyMerge",
          "when": "view == gitfix.conflicts && gitfix:hasMerge",
          "group": "navigation@2"
        },
        {
          "command": "gitfix.abortMerge",
          "when": "view == gitfix.conflicts && gitfix:hasMerge",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "gitfix.openFile",
          "when": "view == gitfix.conflicts && viewItem == conflict",
          "group": "navigation@1"
        },
        {
          "command": "gitfix.resolveMergiraf",
          "when": "view == gitfix.conflicts && viewItem == conflict",
          "group": "resolve@1"
        },
        {
          "command": "gitfix.resolveOurs",
          "when": "view == gitfix.conflicts && viewItem == conflict",
          "group": "resolve@2"
        },
        {
          "command": "gitfix.resolveTheirs",
          "when": "view == gitfix.conflicts && viewItem == conflict",
          "group": "resolve@3"
        },
        {
          "command": "gitfix.resolveTakeTarget",
          "when": "view == gitfix.conflicts && viewItem == conflict && gitfix:conflictHasTakeTarget",
          "group": "resolve@4"
        },
        {
          "command": "gitfix.resolveBatchMergiraf",
          "when": "view == gitfix.conflicts && viewItem == conflict",
          "group": "batch@1"
        },
        {
          "command": "gitfix.showAuditRef",
          "when": "view == gitfix.conflicts && viewItem == merge",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        { "command": "gitfix.refresh" },
        { "command": "gitfix.showAuditRef", "when": "gitfix:hasMerge" },
        { "command": "gitfix.applyMerge", "when": "gitfix:hasMerge" },
        { "command": "gitfix.abortMerge", "when": "gitfix:hasMerge" },
        { "command": "gitfix.configureAiProvider" },
        { "command": "gitfix.openFile", "when": "false" },
        { "command": "gitfix.resolveOurs", "when": "false" },
        { "command": "gitfix.resolveTheirs", "when": "false" },
        { "command": "gitfix.resolveMergiraf", "when": "false" },
        { "command": "gitfix.resolveTakeTarget", "when": "false" },
        { "command": "gitfix.resolveBatchMergiraf", "when": "false" },
        { "command": "gitfix.resolveAi", "when": "false" }
      ]
    },
    "configuration": {
      "title": "gitfix",
      "properties": {
        "gitfix.gfixPath": {
          "type": "string",
          "default": "gfix",
          "description": "Path to the gfix binary. Defaults to 'gfix' (resolved via PATH). Override with an absolute path if needed."
        },
        "gitfix.activateOnGitMerge": {
          "type": "boolean",
          "default": true,
          "description": "Auto-activate the conflict tree when VS Code detects an in-progress merge."
        },
        "gitfix.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline CodeLens buttons above git conflict markers."
        },
        "gitfix.aiProvider": {
          "type": "string",
          "enum": ["host", "byok", "none"],
          "default": "host",
          "description": "AI suggestion source. 'host' uses VS Code's Language Model API (Copilot, etc.). 'byok' uses keys from ~/.config/gitfix/keys.toml or env. 'none' disables AI."
        },
        "gitfix.ai.budgetWarningAt": {
          "type": "number",
          "default": 8,
          "description": "Show a notification when AI suggestion count reaches this number (default budget is 10/merge)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "package": "node esbuild.config.js --production",
    "lint": "eslint src --ext ts",
    "test:compile": "tsc -p ./",
    "test": "node ./out/test/runTest.js",
    "test:integration": "node ./out/test/runIntegrationTest.js",
    "vsce:package": "vsce package --pre-release",
    "vsce:publish": "vsce publish --pre-release",
    "ovsx:publish": "ovsx publish --pre-release"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.92.0",
    "@types/mocha": "^10.0.6",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.24.0",
    "ovsx": "^0.9.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "mocha": "^10.3.0",
    "typescript": "^5.3.0"
  }
}
